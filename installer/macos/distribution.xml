<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>VRCX Bot Blocker</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="always" require-scripts="true" hostArchitectures="x86_64,arm64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="share"/>
        <line choice="main"/>
    </choices-outline>
    <choice id="share" title="Use and contribute to the shared blocklist" start_selected="true">
        <pkg-ref id="net.omnicrash.vrcx-bot-blocker.share"/>
    </choice>
    <choice id="main" title="VRCX Bot Blocker" start_selected="true" start_enabled="false">
        <pkg-ref id="net.omnicrash.vrcx-bot-blocker"/>
    </choice>
    <pkg-ref id="net.omnicrash.vrcx-bot-blocker.share" version="@VERSION@" onConclusion="none">share.pkg</pkg-ref>
    <pkg-ref id="net.omnicrash.vrcx-bot-blocker" version="@VERSION@" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
